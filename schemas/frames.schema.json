{
  "type": "array",
  "items": {
    "$ref": "#/definitions/IFrame"
  },
  "definitions": {
    "IFrame": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "license_level": {
          "type": "number"
        },
        "license_id": {
          "type": "string"
        },
        "variant": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "mechtype": {
          "type": "array",
          "items": {
            "enum": [
              "Artillery",
              "Balanced",
              "Controller",
              "Defender",
              "Striker",
              "Support"
            ],
            "type": "string"
          }
        },
        "specialty": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/definitions/IPrerequisite"
            }
          ]
        },
        "description": {
          "type": "string"
        },
        "mounts": {
          "type": "array",
          "items": {
            "$ref": "enums/mount_type.schema.json#"
          }
        },
        "stats": {
          "$ref": "#/definitions/IFrameStats"
        },
        "traits": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/IFrameTraitData"
          }
        },
        "core_system": {
          "$ref": "#/definitions/ICoreSystemData"
        },
        "image_url": {
          "type": "string"
        },
        "y_pos": {
          "type": "number"
        },
        "other_art": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tag": {
                "$ref": "#/definitions/ImageTag"
              },
              "src": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          },
          "deprecated": true
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "common/actions.schema.json"
          },
          "deprecated": true
        },
        "bonuses": {
          "type": "array",
          "items": {
            "$ref": "common/interfaces.schema.json#/definitions/IBonusData"
          },
          "deprecated": true
        },
        "synergies": {
          "type": "array",
          "items": {
            "$ref": "common/interfaces.schema.json#/definitions/ISynergyData"
          },
          "deprecated": true
        },
        "deployables": {
          "type": "array",
          "items": {
            "$ref": "common/interfaces.schema.json#/definitions/IDeployableData"
          },
          "deprecated": true
        },
        "counters": {
          "type": "array",
          "items": {
            "$ref": "common/interfaces.schema.json#/definitions/ICounterData"
          },
          "deprecated": true
        },
        "integrated": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "deprecated": true
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "common/interfaces.schema.json#/definitions/ITagData"
          },
          "deprecated": true
        }
      },
      "required": [
        "id",
        "license_level",
        "license_id",
        "source",
        "name",
        "mechtype",
        "description",
        "mounts",
        "stats",
        "traits",
        "core_system"
      ]
    },
    "IPrerequisite": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "min_rank": {
          "type": "number"
        },
        "cumulative": {
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "min_rank"
      ]
    },
    "IFrameStats": {
      "type": "object",
      "properties": {
        "size": {
          "type": "number"
        },
        "structure": {
          "type": "number"
        },
        "stress": {
          "type": "number"
        },
        "armor": {
          "type": "number"
        },
        "hp": {
          "type": "number"
        },
        "evasion": {
          "type": "number"
        },
        "edef": {
          "type": "number"
        },
        "heatcap": {
          "type": "number"
        },
        "repcap": {
          "type": "number"
        },
        "sensor_range": {
          "type": "number"
        },
        "tech_attack": {
          "type": "number"
        },
        "save": {
          "type": "number"
        },
        "speed": {
          "type": "number"
        },
        "sp": {
          "type": "number"
        }
      },
      "required": [
        "armor",
        "edef",
        "evasion",
        "heatcap",
        "hp",
        "repcap",
        "save",
        "sensor_range",
        "size",
        "sp",
        "speed",
        "stress",
        "structure",
        "tech_attack"
      ]
    },
    "IFrameTraitData": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "use": {
          "$ref": "enums/duration.schema.json#",
          "deprecated": true
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "common/actions.schema.json"
          }
        },
        "bonuses": {
          "type": "array",
          "items": {
            "$ref": "common/interfaces.schema.json#/definitions/IBonusData"
          }
        },
        "synergies": {
          "type": "array",
          "items": {
            "$ref": "common/interfaces.schema.json#/definitions/ISynergyData"
          }
        },
        "deployables": {
          "type": "array",
          "items": {
            "$ref": "common/interfaces.schema.json#/definitions/IDeployableData"
          }
        },
        "counters": {
          "type": "array",
          "items": {
            "$ref": "common/interfaces.schema.json#/definitions/ICounterData"
          }
        },
        "integrated": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "description",
        "name"
      ]
    },
    "ICoreSystemData": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "active_name": {
          "type": "string"
        },
        "active_effect": {
          "type": "string"
        },
        "activation": {
          "$ref": "enums/activation_type.schema.json#"
        },
        "deactivation": {
          "$ref": "enums/activation_type.schema.json#"
        },
        "use": {
          "$ref": "enums/duration.schema.json#"
        },
        "active_actions": {
          "type": "array",
          "items": {
            "$ref": "common/actions.schema.json"
          }
        },
        "active_effects": {
          "$ref": "common/active_effect.schema.json"
        },
        "active_bonuses": {
          "type": "array",
          "items": {
            "$ref": "common/interfaces.schema.json#/definitions/IBonusData"
          }
        },
        "active_synergies": {
          "type": "array",
          "items": {
            "$ref": "common/interfaces.schema.json#/definitions/ISynergyData"
          }
        },
        "passive_name": {
          "type": "string"
        },
        "passive_effect": {
          "type": "string"
        },
        "passive_actions": {
          "type": "array",
          "items": {
            "$ref": "common/actions.schema.json"
          }
        },
        "passive_bonuses": {
          "type": "array",
          "items": {
            "$ref": "common/interfaces.schema.json#/definitions/IBonusData"
          }
        },
        "passive_synergies": {
          "type": "array",
          "items": {
            "$ref": "common/interfaces.schema.json#/definitions/ISynergyData"
          }
        },
        "deployables": {
          "type": "array",
          "items": {
            "$ref": "common/interfaces.schema.json#/definitions/IDeployableData"
          }
        },
        "counters": {
          "type": "array",
          "items": {
            "$ref": "common/interfaces.schema.json#/definitions/ICounterData"
          }
        },
        "integrated": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "special_equipment": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "common/interfaces.schema.json#/definitions/ITagData"
          }
        }
      },
      "required": [
        "name",
        "description",
        "active_name",
        "active_effect",
        "activation"
      ]
    },
    "ImageTag": {
      "enum": [
        "enemy",
        "frame",
        "location",
        "logo",
        "map",
        "mech",
        "misc",
        "npc",
        "object",
        "pilot"
      ],
      "type": "string"
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}