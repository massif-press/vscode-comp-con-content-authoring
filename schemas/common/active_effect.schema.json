{
    "type": "object",
    "$id": "common/ActiveEffects",
    "properties": {
        "name": {
            "type": "string"
        },
        "detail": {
            "type": "string"
        },
        "condition": {
            "type": "string"
        },
        "frequency": {
            "$ref": "../enums/frequency.schema.json#"
        },
        "duration": {
            "$ref": "../enums/durationV3.schema.json#"
        },
        "bonus_damage": {
            "type": "string"
        },
        "damage": {
            "$ref": "IDamageData.schema.json#"
        },
        "range": {
            "$ref": "IRangeData.schema.json#"
        },
        "add_status": {
            "type": "array",
            "items": {
                "$ref": "IStatusEffectData.schema.json#"
            }
        },
        "add_resist": {
            "type": "array",
            "items": {
                "$ref": "IResistanceData.schema.json#"
            }
        },
        "add_special": {
            "type": "array",
            "items": {
                "$ref": "ISpecialStatusData.schema.json#"
            }
        },
        "remove_special": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "add_other": {
            "type": "array",
            "items": {
                "$ref": "IOtherEffectData.schema.json#"
            }
        },
        "save": {
            "$ref": "IEffectSaveData.schema.json#"
        },
        "attack": {
            "enum": [
                "melee",
                "ranged",
                "tech"
            ]
        },
        "pilot": {
            "type": "boolean"
        },
        "mech": {
            "type": "boolean"
        },
        "accuracy": {
            "type": "number"
        },
        "tech_accuracy": {
            "type": "number"
        },
        "attack_bonus": {
            "type": "number"
        },
        "tech_attack_bonus": {
            "type": "number"
        }
    },
    "required": [
        "name",
        "detail"
    ],
    "$schema": "https://json-schema.org/draft-07/schema#"
}