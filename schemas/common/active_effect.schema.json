{
    "type": "object",
    "$id": "common/ActiveEffects",
    "properties": {
        "name": {
            "type": "string"
        },
        "detail": {
            "type": "string"
        },
        "condition": {
            "type": "string"
        },
        "frequency": {
            "$ref": "../enums/frequency.schema.json#"
        },
        "duration": {
            "$ref": "../enums/durationV3.schema.json#"
        },
        "bonus_damage": {
            "type": "string"
        },
        "damage": {
            "$ref": "#/definitions/IDamageData"
        },
        "range": {
            "$ref": "#/definitions/IRangeData"
        },
        "add_status": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/IStatusEffectData"
            }
        },
        "add_resist": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/IResistanceData"
            }
        },
        "add_special": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/ISpecialStatusData"
            }
        },
        "remove_special": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "add_other": {
            "type": "array",
            "items": {
                "$ref": "#/definitions/IOtherEffectData"
            }
        },
        "save": {
            "$ref": "#/definitions/IEffectSaveData"
        },
        "attack": {
            "enum": [
                "melee",
                "ranged",
                "tech"
            ]
        },
        "pilot": {
            "type": "boolean"
        },
        "mech": {
            "type": "boolean"
        },
        "accuracy": {
            "type": "number"
        },
        "tech_accuracy": {
            "type": "number"
        },
        "attack_bonus": {
            "type": "number"
        },
        "tech_attack_bonus": {
            "type": "number"
        }
    },
    "required": [
        "name",
        "detail"
    ],
    "definitions": {
        "IDamageData": {
            "type": "object",
            "properties": {
                "type": {
                    "$ref": "../enums/damage_type.schema.json#"
                },
                "val": {
                    "anyOf": [
                        {
                            "type": "string",
                            "examples": [
                                "1d6",
                                "(1d6+2)*2",
                                "2d6+{agi}"
                            ]
                        },
                        {
                            "type": "number"
                        }
                    ]
                },
                "aoe": {
                    "anyOf": [
                        {
                            "type": "boolean"
                        },
                        {
                            "type": "string",
                            "examples": [
                                "burst 3",
                                "blast 2"
                            ]
                        }
                    ]
                },
                "save": {
                    "$ref": "#/definitions/IEffectSaveData"
                },
                "save_half": {
                    "type": "boolean",
                    "description": "If true, targets that succeed on their saving throws take half damage. Otherwise, targets that succeed on their saving throws take NO damage."
                },
                "ap": {
                    "type": "boolean",
                    "description": "If true, the damage ignores armor"
                },
                "target": {
                    "enum": [
                        "self",
                        "ally",
                        "enemy"
                    ]
                }
            },
            "required": [
                "type",
                "val"
            ]
        },
        "IRangeData": {
            "type": "object",
            "properties": {
                "type": {
                    "enum": [
                        "Threat",
                        "Range",
                        "Burst",
                        "Blast",
                        "Cone",
                        "Line"
                    ]
                },
                "val": {
                    "anyOf": [
                        {
                            "type": "string",
                            "examples": [
                                "1d6",
                                "(1d6+2)*2",
                                "2d6+{agi}"
                            ]
                        },
                        {
                            "type": "number"
                        }
                    ]
                },
                "min": {
                    "anyOf": [
                        {
                            "type": "string",
                            "examples": [
                                "1d6",
                                "(1d6+2)*2",
                                "2d6+{agi}"
                            ]
                        },
                        {
                            "type": "number"
                        }
                    ]
                }
            },
            "required": [
                "type",
                "val"
            ]
        },
        "IStatusEffectData": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "duration": {
                    "$ref": "../enums/durationV3.schema.json#"
                },
                "save": {
                    "enum": [
                        "hull",
                        "agi",
                        "sys",
                        "eng",
                        "grit"
                    ]
                },
                "aoe": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "boolean"
                        }
                    ]
                },
                "target": {
                    "enum": [
                        "self",
                        "ally",
                        "enemy"
                    ]
                }
            },
            "required": [
                "id"
            ]
        },
        "IResistanceData": {
            "type": "object",
            "properties": {
                "immunity": {
                    "anyOf": [
                        {
                            "enum": [
                                "kinetic",
                                "energy",
                                "explosive",
                                "heat",
                                "burn",
                                "aoe",
                                "all"
                            ]
                        },
                        {
                            "type": "string",
                            "description": "Status or Condition ID defined in `statuses.json` in core data, this LCP, or any of its dependencies."
                        }
                    ]
                },
                "resistance": {
                    "enum": [
                        "kinetic",
                        "energy",
                        "explosive",
                        "heat",
                        "burn",
                        "aoe",
                        "all"
                    ]
                },
                "vulnerability": {
                    "enum": [
                        "kinetic",
                        "energy",
                        "explosive",
                        "heat",
                        "burn",
                        "aoe",
                        "all"
                    ]
                },
                "target": {
                    "enum": [
                        "self",
                        "ally",
                        "enemy"
                    ],
                    "default": "self"
                }
            },
            "required": []
        },
        "ISpecialStatusData": {
            "type": "object",
            "properties": {
                "attribute": {
                    "type": "string"
                },
                "detail": {
                    "type": "string"
                },
                "target": {
                    "enum": [
                        "self",
                        "ally",
                        "enemy"
                    ],
                    "default": "enemy"
                },
                "duration": {
                    "$ref": "../enums/durationV3.schema.json"
                }
            },
            "required": [
                "attribute"
            ]
        },
        "IOtherEffectData": {
            "type": "object",
            "properties": {
                "type": {
                    "enum": [
                        "overshield",
                        "hp",
                        "repair",
                        "cover"
                    ]
                },
                "val": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "number"
                        }
                    ]
                },
                "target": {
                    "enum": [
                        "self",
                        "ally",
                        "enemy"
                    ]
                },
                "aoe": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "boolean"
                        }
                    ]
                }
            }
        },
        "IEffectSaveData": {
            "anyOf": [
                {
                    "enum": [
                        "hull",
                        "agi",
                        "sys",
                        "eng",
                        "grit"
                    ]
                },
                {
                    "type": "object",
                    "properties": {
                        "stat": {
                            "type": "string"
                        },
                        "aoe": {
                            "type": "boolean"
                        }
                    },
                    "required": [
                        "stat"
                    ]
                }
            ]
        }
    },
    "$schema": "https://json-schema.org/draft-07/schema#"
}