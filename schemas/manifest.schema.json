{
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "item_prefix": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "v3": {
      "type": "boolean",
      "description": "Is this LCP compatible with Comp/Con v3?"
    },
    "version_history": {
        "type": "array",
        "items": {
          "$ref": "#/definitions/IChangeLogItem"
        }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ILcpDependencies"
      }
    }
  },
  "required": [
    "author",
    "name",
    "description",
    "version"
  ],
  "definitions": {
    "ILcpDependencies": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^(\\*|=?[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9a-zA-Z-\\.]+)?)$"
        },
        "link": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "IChangeLogItem": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9a-zA-Z-\\.]+)?$"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}