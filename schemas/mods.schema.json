          "items": {
            "$ref": "enums/weapon_size.schema.json#"
          }
        },
        "restricted_types": {
          "type": "array",
          "items": {
            "$ref": "enums/weapon_type.schema.json#"
          }
        },
        "restricted_sizes": {
          "type": "array",
          "items": {
            "$ref": "enums/weapon_size.schema.json#"
          }
        },
        "added_tags": {
          "type": "array",
          "items": {
            "$ref": "common/interfaces.schema.json#/definitions/ITagData"
          }
        },
        "added_damage": {
          "type": "array",
          "items": {
            "$ref": "common/interfaces.schema.json#/definitions/IDamageData"
          }
        },
        "added_range": {
          "type": "array",
          "items": {
            "$ref": "common/interfaces.schema.json#/definitions/IRangeData"
          }
        },
        "actions": {
          "anyOf": [
